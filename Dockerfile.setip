# Personal build of headscale v0.29.6 with "nodes set-ip". Mirrors the
# official image layout (distroless base, binary at /ko-app/headscale) so it
# is a drop-in replacement for headscale/headscale:v0.29.6 in docker compose.
#
#   docker build -f Dockerfile.setip -t headscale-local:v0.29.6-setip .
#
# The binary reports version v0.29.6+setip. The "+setip" build metadata is
# ignored by headscale's database version check and by the update check, so
# both treat it as v0.29.6. Override with --build-arg VERSION=... if needed.

# Go 1.27.3 or newer is required (CVE-2026-111943, see CHANGELOG 0.29.6).
FROM docker.io/golang:1.27.3-trixie AS builder
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

ARG VERSION=v0.29.6+setip
COPY . .
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath \
    -ldflags="-s -w -X github.com/juanfont/headscale/hscontrol/types.Version=${VERSION}" \
    -o /out/headscale ./cmd/headscale

# Same pinned base as the official 0.29.6 image (.goreleaser.yml).
FROM gcr.io/distroless/base-debian13@sha256:f5e95195e998742ff590b7569bae479accce1226e51ae6c3118954030121cdcb
COPY --from=builder /out/headscale /ko-app/headscale
ENV PATH=/ko-app:$PATH
ENTRYPOINT ["/ko-app/headscale"]
